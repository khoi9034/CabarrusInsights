APP_ENV=dev
CFS_RUNTIME_MODE=local
CFS_DATA_PROVIDER=local_api
CFS_AUTH_MODE=local_dev
CFS_ARTIFACT_PROVIDER=local_file
CFS_JOB_PROVIDER=inline
CFS_PRESENTATION_CACHE_ENABLED=false
CFS_PRESENTATION_FREEZE_ID=unfrozen
CFS_LIVE_REFRESH_ENABLED=false
CFS_LIVE_REFRESH_TIMEOUT_SECONDS=900

# Server-only database settings.
# Prefer DATABASE_URL for cloud deployments. Never expose this value to the
# frontend and never prefix it with NEXT_PUBLIC_.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=3000
CFS_DATABASE_AUTH_MODE=password
CFS_DATABASE_POOL_SIZE=2
CFS_DATABASE_MAX_OVERFLOW=1
CFS_DATABASE_POOL_TIMEOUT_SECONDS=10
CFS_DATABASE_POOL_RECYCLE_SECONDS=2700

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cfs_dev
POSTGRES_USER=postgres

# Prefer POSTGRES_PASSWORD for the API.
# Local development may also rely on CFS_POSTGRES_PASSWORD already set in Windows.
POSTGRES_PASSWORD=

SQLALCHEMY_ECHO=false
CFS_ENABLE_DOCS=true
CFS_TELEMETRY_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional backend-only Ask CFS provider settings. Leave disabled for the
# deterministic local fallback. Real local keys belong in ../backend.env,
# never in frontend env or Vercel demo env.
CFS_AI_ENABLED=false
CFS_AI_PROVIDER=none
CFS_AI_MODEL=
CFS_AI_PROVIDER_TIMEOUT_SECONDS=6
OPENAI_API_KEY=

# Optional backend-only EagleView/Pictometry parcel imagery. Keep these in
# backend.env or the server secret store; never prefix them with NEXT_PUBLIC_.
CFS_EAGLEVIEW_API_KEY=
CFS_EAGLEVIEW_SECRET_KEY=
CFS_EAGLEVIEW_TIMEOUT_SECONDS=10
CFS_COUNTY_TAX_RATE_PER_100=0.57

# Comma-separated local frontend origins that may call the API in development.
# Production should use explicit deployment origins only.
# Example production value:
# CORS_ALLOWED_ORIGINS=https://<vercel-project>.vercel.app,https://<custom-domain>
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3003,http://127.0.0.1:3003

# Operator-only backup destination. Keep dumps outside this repository.
# CFS_BACKUP_DIRECTORY=D:\CabarrusInsightsBackups

# Azure staging authentication. Keep the staging token while Entra rollout is
# being validated; do not put the token in frontend env.
# CFS_STAGING_PROTECT_API=true
# CFS_STAGING_ACCESS_TOKEN=
# CFS_AUTH_MODE=oidc
# CFS_ENTRA_TENANT_ID=<tenant-id>
# CFS_ENTRA_API_AUDIENCE=api://<api-client-id>
# CFS_ORGANIZATION_ID=<provisioned-cfs-organization-id>
# CFS_ENTRA_REQUIRED_SCOPE=CFS.Access
# CFS_ENTRA_ALLOWED_OBJECT_IDS=<comma-separated-user-or-group-object-ids>
# CFS_ENTRA_WRITE_ROLE=CFS.Write
# CFS_ENTRA_ADMIN_ROLE=CFS.Admin

# Process-local cache for the static Model Lab summary. Set to 0 to disable.
CFS_MODEL_LAB_SUMMARY_CACHE_TTL_SECONDS=21600
