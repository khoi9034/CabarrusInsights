# Cabarrus Insights browser-safe configuration only.
# Copy to .env.local for development. Never put passwords, API keys, bearer
# tokens, or database URLs in NEXT_PUBLIC_* variables.

# LOCAL_DEMO / supported internal presentation profile
NEXT_PUBLIC_CFS_RUNTIME_MODE=local
NEXT_PUBLIC_CFS_DATA_PROVIDER=local_api
NEXT_PUBLIC_CFS_AUTH_MODE=local_dev
NEXT_PUBLIC_CFS_AI_PROVIDER=none
NEXT_PUBLIC_CFS_ARTIFACT_PROVIDER=local_file
NEXT_PUBLIC_CFS_JOB_PROVIDER=inline
NEXT_PUBLIC_CFS_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_BACKEND_API=true
NEXT_PUBLIC_CFS_ONLINE_BASEMAP=false
NEXT_PUBLIC_CFS_BASEMAP_ATTRIBUTION=OpenFreeMap © OpenMapTiles Data from OpenStreetMap

# Optional approved credential-free HTTPS raster tile template.
# NEXT_PUBLIC_CFS_BASEMAP_URL_TEMPLATE=https://tiles.example.gov/{z}/{x}/{y}.png

# Public static demo (no backend, database, provider, or private data)
# NEXT_PUBLIC_CFS_RUNTIME_MODE=demo
# NEXT_PUBLIC_CFS_DATA_PROVIDER=static
# NEXT_PUBLIC_CFS_AUTH_MODE=off
# NEXT_PUBLIC_CFS_AI_PROVIDER=none
# NEXT_PUBLIC_CFS_ARTIFACT_PROVIDER=public_static
# NEXT_PUBLIC_CFS_JOB_PROVIDER=inline
# NEXT_PUBLIC_USE_BACKEND_API=false

# INTERNAL_PRODUCTION contract. Do not enable until the deployment blockers in
# docs/PRODUCTION_READINESS.md are closed.
# NEXT_PUBLIC_CFS_RUNTIME_MODE=enterprise
# NEXT_PUBLIC_CFS_DATA_PROVIDER=enterprise_api
# NEXT_PUBLIC_CFS_AUTH_MODE=oidc
# NEXT_PUBLIC_CFS_AI_PROVIDER=none
# NEXT_PUBLIC_CFS_ARTIFACT_PROVIDER=object_storage
# NEXT_PUBLIC_CFS_JOB_PROVIDER=external_worker
# NEXT_PUBLIC_CFS_API_BASE_URL=https://insights-api.example.gov
# NEXT_PUBLIC_CFS_ENTRA_TENANT_ID=<public-tenant-id>
# NEXT_PUBLIC_CFS_ENTRA_CLIENT_ID=<public-spa-client-id>
# NEXT_PUBLIC_CFS_ENTRA_API_SCOPE=api://<public-api-client-id>/CFS.Access

# Developer-only diagnostics. Keep false for ordinary users.
# NEXT_PUBLIC_CFS_DEVELOPER_MODE=false

# Legacy compatibility only; prefer the canonical settings above.
# NEXT_PUBLIC_CFS_DEPLOYMENT_MODE=live
