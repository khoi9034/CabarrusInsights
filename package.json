{
  "name": "cabarrusfuturescape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "assets:arcgis": "node scripts/sync-arcgis-assets.mjs",
    "predev": "npm run assets:arcgis",
    "prebuild": "npm run assets:arcgis",
    "dev": "next dev -p 3000",
    "dev:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cfs-local.ps1",
    "present:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cfs-presentation.ps1",
    "cache:demo": "python scripts/prewarm_cfs_local.py --rebuild",
    "stop:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-cfs-local.ps1",
    "restart:cfs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cfs-presentation.ps1",
    "check:internal-readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-cfs-internal.ps1",
    "backup:database": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-cfs-database.ps1",
    "build": "next build --webpack",
    "db:status": "python backend/migrations/manage.py status",
    "db:check": "python backend/migrations/manage.py check",
    "db:migrate": "python backend/migrations/manage.py upgrade",
    "db:rollback-one": "python backend/migrations/manage.py rollback-one",
    "check:acceptance": "node scripts/check-product-acceptance.mjs",
    "check:arcgis-assets": "node scripts/sync-arcgis-assets.mjs --check",
    "check:ask-cfs": "python scripts/check_ask_cfs.py",
    "check:ask-cfs-map-context": "node scripts/check-ask-cfs-map-context.mjs",
    "check:backend-recovery": "node scripts/check-backend-recovery.mjs",
    "check:data-provenance": "python scripts/check_data_provenance.py",
    "check:demo-functionality": "node scripts/check-demo-functionality.mjs",
    "check:demo-interactions": "node scripts/check-demo-interactions.mjs",
    "check:eagleview-imagery": "node scripts/check-eagleview-imagery.mjs",
    "check:eagleview-imagery-local": "node scripts/check-eagleview-imagery.mjs --local",
    "check:local-data": "python scripts/check_cfs_local_data.py",
    "check:local-demo-performance": "node scripts/check-local-demo-performance.mjs",
    "check:local-apis": "node scripts/check-local-apis.mjs",
    "check:local-interactions": "node scripts/check-local-interactions.mjs",
    "check:management-handoff": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-management-handoff.mjs",
    "check:management-context": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-management-context.mjs",
    "check:snapshot-experience": "node scripts/check-snapshot-experience.mjs",
    "check:local-presentation": "node scripts/check-local-presentation.mjs",
    "check:master-data-v1b": "node scripts/check-master-data-v1b.mjs",
    "check:master-data-v1b-local": "node scripts/check-master-data-v1b.mjs --local",
    "check:enterprise-readiness": "python scripts/check_enterprise_readiness.py",
    "check:frontend-persistence": "node scripts/check-frontend-persistence.mjs",
    "check:interactive-map": "node scripts/check-interactive-map.mjs",
    "check:map-classification": "node scripts/map-acceptance-classification.mjs",
    "check:map-resilience": "node scripts/check-map-resilience.mjs",
    "check:runtime-config": "node scripts/check-runtime-config.mjs",
    "check:api-contracts": "python -m pytest backend/tests/product_v1/test_api_contracts.py -q",
    "check:migrations": "python -m pytest backend/tests/product_v1/test_migrations.py -q",
    "check:persistence": "python -m pytest backend/tests/product_v1/test_persistence.py -q",
    "check:authorization": "python -m pytest backend/tests/product_v1/test_authorization.py backend/tests/product_v1/test_admin_users.py -q",
    "check:audit": "python -m pytest backend/tests/product_v1/test_audit.py -q",
    "check:ingestion": "python -m pytest backend/tests/product_v1/test_ingestion.py -q",
    "check:containers": "node scripts/check-containers.mjs",
    "check:product-v1": "node scripts/check-product-v1.mjs",
    "check:product-v1-soak": "node scripts/check-product-v1-soak.mjs",
    "check:powerbi": "python scripts/check_powerbi.py",
    "check:product-hardening": "node scripts/check-product-hardening.mjs",
    "check:presentation": "node scripts/check-presentation.mjs",
    "check:production-map": "node scripts/check-production-map.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arcgis/core": "5.0.19",
    "@azure/msal-browser": "^4.30.0",
    "@tanstack/charts": "0.16.0",
    "@zip.js/zip.js": "~2.8.16",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright-core": "1.62.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
